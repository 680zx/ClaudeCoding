# Copy to deploy/.env and adjust. Compose loads it automatically.

# Absolute path to this checkout on the DOCKER HOST.
#
# Only needed for live trading: the API launches the live worker with
# `docker run -v`, and the daemon resolves those paths against the host, not
# against the API container's own filesystem. Backtesting works without it.
PARALLELS_HOST_ROOT=/absolute/path/to/ClaudeCoding

# Host ports, if the defaults collide.
#PARALLELS_API_PORT=5080
#PARALLELS_WEB_PORT=5173

# Binance credentials. Passed to the live container at launch and never written
# into stored desired state.
#BINANCE_API_KEY=
#BINANCE_API_SECRET=
#BINANCE_ENVIRONMENT=testnet

# Must be exactly "true" for the live worker to trade real funds on mainnet.
#PARALLELS_CONFIRM_MAINNET=false
