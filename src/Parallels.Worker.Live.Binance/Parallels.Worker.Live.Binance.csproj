<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Parallels.Worker.Live.Binance</AssemblyName>
    <RootNamespace>Parallels.Worker.Live.Binance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Parallels.Contracts\Parallels.Contracts.csproj" />
    <ProjectReference Include="..\Parallels.Strategies\Parallels.Strategies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuantConnect.Lean.Engine" />
    <PackageReference Include="QuantConnect.AlgorithmFactory" />
    <PackageReference Include="QuantConnect.Configuration" />
    <PackageReference Include="QuantConnect.Logging" />
    <PackageReference Include="QuantConnect.Common" />
    <!-- Broker-specific: this project (and its image) is Binance-only by
         design. A second broker is a new project + new Dockerfile, so no other
         broker's SDK is ever in this image. Spec 3.2. -->
    <PackageReference Include="QuantConnect.Brokerages" />
    <PackageReference Include="QuantConnect.Brokerages.Binance" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
