<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one shared algorithm host class plus every AlphaModel. A LEAN
       reference is expected and correct here (spec 3.1) — strategy logic
       belongs against LEAN's own types, not abstracted away from them. -->

  <ItemGroup>
    <ProjectReference Include="..\Parallels.Contracts\Parallels.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SessionContext's single-publish guard is deliberately not resettable in
         production. Tests need to reset it to assert the guard itself fires. -->
    <InternalsVisibleTo Include="Parallels.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuantConnect.Common" />
    <PackageReference Include="QuantConnect.Algorithm" />
    <!-- Portfolio construction models (InsightWeighting...) ship in this
         assembly rather than QuantConnect.Algorithm. -->
    <PackageReference Include="QuantConnect.Algorithm.Framework" />
    <PackageReference Include="QuantConnect.Indicators" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
